# Maintainer: PatAmigo0 <arseni.kuskou@innowise.com>
pkgname=cavawall-git
pkgver=r1.0000000
pkgrel=1
pkgdesc="Wayland audio visualiser that draws cava over your wallpaper"
arch=('x86_64')
url="https://github.com/PatAmigo0/cavawall"
license=('GPL-3.0-or-later')
depends=('cava' 'wayland' 'libglvnd' 'libffi' 'gcc-libs' 'glibc')
makedepends=('git' 'cargo')
provides=('cavawall')
conflicts=('cavawall')
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # .cargo/config.toml in the checkout asks for target-cpu=native, which
  # would leak into the package. RUSTFLAGS in the environment takes
  # precedence over that file, so setting it here is what stops the leak.
  #
  # makepkg.conf wins when it has an opinion: a distribution that builds on
  # the target machine sets native or a microarchitecture level there, and
  # that choice is the packager's. The baseline is only the fallback for a
  # makepkg.conf that says nothing, where the alternative is native.
  export RUSTFLAGS="${RUSTFLAGS:--C target-cpu=x86-64}"
  cargo build --frozen --release --all-features
}

check() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export RUSTFLAGS="${RUSTFLAGS:--C target-cpu=x86-64}"
  cargo test --frozen --release
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/cavawall "$pkgdir/usr/bin/cavawall"
  install -Dm755 target/release/cavawall-curve "$pkgdir/usr/bin/cavawall-curve"
  install -Dm755 target/release/cavawallctl "$pkgdir/usr/bin/cavawallctl"
  # Not into /etc: cavawall reads ~/.config/cavawall/config.toml and this is
  # the annotated example to copy from, not a system default it would load.
  install -Dm644 config.toml "$pkgdir/usr/share/cavawall/config.toml"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  # Upstream's notice travels with the code it covers, so it ships too.
  install -Dm644 LICENSE.MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE.MIT"
}
